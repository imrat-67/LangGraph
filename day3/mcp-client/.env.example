# Copy to .env and fill in what you need.

# Override the Ollama model (must support tool calling)
# OLLAMA_MODEL=qwen3:8b

# Bearer token for the deployed custom-tools server (FastMCP Cloud / Prefect
# Horizon). Get this from that deployment's dashboard -> API keys / access
# tokens, then uncomment and paste it below.
# FASTMCP_DEPLOYED_TOKEN=
